{
  "name": "@yansera/dsh-living-memoir",
  "version": "1.0.0",
  "description": "Long-term memory for DeepSeek Harness: a short, categorized Markdown living document that gets rewritten instead of appended to, with a dedicated Web GUI page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "agent-memory",
    "long-term-memory",
    "markdown",
    "memoir"
  ],
  "homepage": "https://github.com/Yansera/dsh-living-memoir#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yansera/dsh-living-memoir.git"
  },
  "bugs": {
    "url": "https://github.com/Yansera/dsh-living-memoir/issues"
  },
  "author": "Yansera <522988394@qq.com>",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test/store.test.mjs && node test/plugin.test.mjs && node test/client.test.mjs && node test/distill.test.mjs",
    "test:store": "node test/store.test.mjs",
    "test:plugin": "node test/plugin.test.mjs",
    "test:client": "node test/client.test.mjs",
    "test:distill": "node test/distill.test.mjs",
    "smoke": "node scripts/smoke-live.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "node": ">=20.18",
      "profiles": [
        "web",
        "desktop"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-system-prompt": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  }
}
